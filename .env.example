# SMTP configuration for contact form
# Use your SMTP provider credentials (e.g., Gmail SMTP, Mailgun, SendGrid SMTP)
# For Gmail, you will likely need an App Password and to enable access.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password

# Destination email (where messages will be sent)
EMAIL_TO=ckarungu921@gmail.com
