# Brevo transactional email (contact notifications + admin replies)
# API key: Brevo > SMTP & API > API keys. FROM_EMAIL must be a verified sender in Brevo.
BREVO_API_KEY=xkeysib-xxxxx_your_brevo_api_key
FROM_EMAIL=verified-sender@example.com
FROM_NAME=Cédric Karungu

# Destination email (where messages will be sent)
EMAIL_TO=ckarungu921@gmail.com

# ---------- MongoDB Atlas ----------
# Connection string (include database name in the path or set MONGODB_DB separately)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cedric-portfolio?retryWrites=true&w=majority
MONGODB_DB=cedric-portfolio

# ---------- Admin authentication ----------
# Seeded on first run / via `npm run seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# JWT secret used to sign admin session cookies (min 32 chars)
JWT_SECRET=replace-with-a-long-random-string-min-32-chars
# Session lifetime (e.g. 7d, 12h)
JWT_EXPIRES_IN=7d

# ---------- Cloudinary project image uploads ----------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
