# SMTP configuration for contact form
# Use your SMTP provider credentials (e.g., Gmail SMTP, Mailgun, SendGrid SMTP)
# For Gmail, you will likely need an App Password and to enable access.

# Option A: SendGrid API (recommended)
# Set your SendGrid API key and a verified sender `FROM_EMAIL`
SENDGRID_API_KEY=SG.xxxxx_your_sendgrid_api_key_xxxxx
FROM_EMAIL=verified-sender@example.com

# Option B: SMTP (legacy) - keep if you want SMTP instead
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password

# Destination email (where messages will be sent)
EMAIL_TO=ckarungu921@gmail.com

# ---------- MongoDB Atlas ----------
# Connection string (include database name in the path or set MONGODB_DB separately)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cedric-portfolio?retryWrites=true&w=majority
MONGODB_DB=cedric-portfolio

# ---------- Admin authentication ----------
# Seeded on first run / via `npm run seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# JWT secret used to sign admin session cookies (min 32 chars)
JWT_SECRET=replace-with-a-long-random-string-min-32-chars
# Session lifetime (e.g. 7d, 12h)
JWT_EXPIRES_IN=7d
